# Dominion Live Ops sync profile (copy values into your shell profile, Task Scheduler env,
# or a secure env file loaded before startup scripts).

# Prefer D: workspace roots on Windows; Linux/WSL can override to /mnt/d equivalents.
DOMINION_WORKSPACE_DIR=D:\workspaces\dominion-os-demo-build
DOMINION_COMMAND_CENTER_DIR=D:\workspaces\dominion-command-center

# Docker preflight on startup (1=enabled, 0=disabled).
PHI_DOCKER_REPAIR_ON_START=1

# Intelligent sync cadence (seconds).
PHI_INTELLIGENT_SYNC_INTERVAL=120

# Local mirror to D: for low-latency local ops durability.
PHI_SYNC_LOCAL_MIRROR_ENABLED=1
PHI_SYNC_LOCAL_MIRROR_MODE=targeted
PHI_SYNC_LOCAL_MIRROR_PATH=D:\workspaces\dominion-os-demo-build-live
PHI_SYNC_LOCAL_MIRROR_FALLBACK_PATH=/workspaces/dominion-os-demo-build-live
PHI_SYNC_LOCAL_MIRROR_PATHS="scripts/telemetry dist/command_core reports"
PHI_SYNC_LOCAL_MIRROR_MIN_INTERVAL_SECONDS=30

# Git-controlled push target.
PHI_SYNC_ENFORCE_CONTROLLED_TARGET=1
PHI_SYNC_CONTROLLED_REMOTE=fork
PHI_SYNC_CONTROLLED_BRANCH=live-ops-sync

# GCS replication (set your bucket to enable).
PHI_SYNC_GCS_ENABLED=1
PHI_SYNC_GCS_BUCKET=
PHI_SYNC_GCS_PREFIX=dominion-live-ops
PHI_SYNC_GCS_MIN_INTERVAL_SECONDS=300
PHI_SYNC_GCS_CHANGED_ONLY=1
PHI_SYNC_GCS_PARALLEL=1
PHI_SYNC_GCS_DELETE_UNMATCHED=0
PHI_SYNC_GCS_INCLUDE_PATHS="scripts/telemetry dist/command_core reports"
PHI_SYNC_GCS_EXCLUDE_REGEX="(^|/)(\\.git/|logs/|scripts/logs/)|\\.(tmp|swp|pid)$"

# Optional: only replicate to mirror/GCS after successful git push.
# PHI_SYNC_REPLICATION_ONLY_ON_PUSH=1

# Ecosystem optimizer daemon (cross-repo + GCP safe tuning cadence).
PHI_ECOSYSTEM_AUDIT_INTERVAL_SECONDS=1800
PHI_ECOSYSTEM_APPLY_SAFE_ENABLED=1
PHI_ECOSYSTEM_APPLY_SAFE_EVERY_CYCLES=12
PHI_ECOSYSTEM_APPLY_MODE=apply-safe
PHI_ECOSYSTEM_GCP_REGION=us-central1
PHI_ECOSYSTEM_GCP_TIMEOUT_SECONDS=8
PHI_ECOSYSTEM_AGGRESSIVE_MAX_INSTANCES_NONPROD=10
PHI_ECOSYSTEM_AGGRESSIVE_ALLOW_PROD=0
PHI_ECOSYSTEM_AGGRESSIVE_MAX_INSTANCES_PROD=30

# Budget authority lock (default deny until explicit Matthew approval variables are set).
PHI_BUDGET_APPROVER_REQUIRED=Matthew\ Burbidge
PHI_BUDGET_INCREASE_APPROVAL=
PHI_BUDGET_INCREASE_APPROVER=
PHI_BUDGET_APPROVAL_REF=
PHI_BUDGET_APPROVAL_AT=

# Local AT2 performance profile.
PHI_LOCAL_MACHINE_PROFILE=AT2_LIVE_OPS
PHI_LOCAL_MACHINE_PERF_MODE=MAX_PERFORMANCE
PHI_LOCAL_MACHINE_COST_MODE=LOWEST_COST

# Official public cloud surface policy (single public surface).
PHI_PUBLIC_SURFACE_OFFICIAL=1
PHI_PUBLIC_SURFACE_REPO=dominion-os-demo-build
PHI_PUBLIC_SURFACE_SCOPE=ONLY_PUBLIC_SURFACE
PHI_PUBLIC_GCP_PROJECT=dominion-core-prod
PHI_PUBLIC_GCP_REGION=us-central1
PHI_PUBLIC_CLOUD_RUN_ALLOWLIST="dominion-os-demo,dominion-demo-service,phi-askphi-widget,phi-oauth-server,api,chatgpt-gateway"

# Restrict deploy/verification scope to the official public project.
PHI_GCLOUD_DEPLOY_PROJECTS="dominion-core-prod"
PHI_ECOSYSTEM_GCP_PROJECTS="dominion-core-prod"

# Cloud governor (ecosystem-level enforcement beyond local machine scope).
PHI_ECOSYSTEM_ALL_GCP_PROJECTS=
PHI_BILLING_ACCOUNT_PRIMARY=01D4E4-6B2BB9-06A851
PHI_CLOUD_GOVERNOR_ENFORCE_SINGLE_BILLING_PUBLIC_PROJECT=1
PHI_CLOUD_GOVERNOR_ENFORCE_NONOFFICIAL_NO_PUBLIC=1
PHI_CLOUD_GOVERNOR_ENSURE_ALLOWLIST_PUBLIC=1
PHI_CLOUD_GOVERNOR_APPLY_ON_REPAIR=1
