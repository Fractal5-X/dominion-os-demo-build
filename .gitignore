__pycache__/
*.pyc
.pytest_cache/
.venv/
dist/
.DS_Store

# Ignore local backup archives
out/backups/
image-digest.txt
out/autopilot/

# Local environment files
.env
scripts/reports/operations_handoff_*.md
scripts/reports/final_*.txt
scripts/reports/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]Z.md
scripts/reports/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]Z.log

# Operational telemetry and logs (generated at runtime)
scripts/telemetry/*.log
scripts/telemetry/*.lock
scripts/telemetry/*.pid
scripts/telemetry/.last_*
scripts/telemetry/gate_*.out
scripts/logs/

# Operational data directories
scripts/data/
scripts/telemetry/tmp/
scripts/telemetry/*.json
# Telemetry files - updated continuously by background monitors
scripts/telemetry/sovereign_status.json
scripts/telemetry/system_status.json

# Other dynamic operational files (if they exist)
scripts/telemetry/*_status.json
scripts/telemetry/gcloud_service_catalog_*.txt
